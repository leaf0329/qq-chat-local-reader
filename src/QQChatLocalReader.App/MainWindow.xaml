<Window x:Class="QQChatLocalReader.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource AppTitle}" Height="760" Width="1240" MinHeight="620" MinWidth="980"
        Background="#F5F7FA" Loaded="Window_Loaded" Closed="Window_Closed">
    <Window.Resources>
        <Style TargetType="Button"><Setter Property="Padding" Value="14,7" /><Setter Property="Margin" Value="4,0" /><Setter Property="MinHeight" Value="34" /></Style>
        <Style TargetType="TextBox"><Setter Property="Padding" Value="8,5" /><Setter Property="MinHeight" Value="34" /></Style>
        <Style TargetType="ComboBox"><Setter Property="MinHeight" Value="34" /><Setter Property="Padding" Value="6,3" /></Style>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="White" CornerRadius="10" Padding="12" BorderBrush="#DDE3EA" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="220" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="26" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="160" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{DynamicResource Account}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox Grid.Column="1" x:Name="AccountBox" DisplayMemberPath="DisplayName" SelectionChanged="AccountBox_SelectionChanged" />
                <Button Grid.Column="2" Content="{DynamicResource RefreshAccounts}" Click="RefreshAccounts_Click" />
                <Button Grid.Column="3" Content="{DynamicResource ReadConversations}" Click="ReadConversations_Click" />
                <TextBlock Grid.Column="5" Text="范围" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox Grid.Column="6" x:Name="RangeBox" SelectionChanged="RangeBox_SelectionChanged">
                    <ComboBoxItem Content="最近 7 个自然日" Tag="7" IsSelected="True" /><ComboBoxItem Content="最近 30 个自然日" Tag="30" /><ComboBoxItem Content="自定义日期" Tag="custom" />
                </ComboBox>
                <DatePicker Grid.Column="7" x:Name="StartDatePicker" Width="130" Margin="8,0,0,0" Visibility="Collapsed" />
                <DatePicker Grid.Column="8" x:Name="EndDatePicker" Width="130" Margin="8,0,0,0" Visibility="Collapsed" />
                <Button Grid.Column="10" Content="{DynamicResource SyncSelected}" Click="SyncSelected_Click" Background="#1565C0" Foreground="White" />
            </Grid>
        </Border>
        <Border Grid.Row="1" Background="White" CornerRadius="10" Padding="12" Margin="0,10" BorderBrush="#DDE3EA" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="160" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="24" /><ColumnDefinition Width="130" /><ColumnDefinition Width="130" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" x:Name="KeywordBox" ToolTip="关键词（可留空）" />
                <TextBox Grid.Column="1" x:Name="SenderBox" Margin="8,0,0,0" ToolTip="发言人 QQ 号（可留空）" />
                <Button Grid.Column="2" Content="{DynamicResource Search}" Click="Search_Click" />
                <ComboBox Grid.Column="4" x:Name="ExportFormatBox" SelectedIndex="0"><ComboBoxItem Content="Markdown" Tag="Markdown" /><ComboBoxItem Content="JSON" Tag="Json" /><ComboBoxItem Content="CSV" Tag="Csv" /></ComboBox>
                <ComboBox Grid.Column="5" x:Name="ExportPrivacyBox" SelectedIndex="0" Margin="8,0,0,0"><ComboBoxItem Content="原始" Tag="Raw" /><ComboBoxItem Content="基础脱敏" Tag="BasicRedaction" /></ComboBox>
                <Button Grid.Column="6" Content="{DynamicResource Export}" Click="Export_Click" /><Button Grid.Column="7" Content="全选" Click="SelectAll_Click" /><Button Grid.Column="8" Content="复制 MCP 配置" Click="CopyMcpConfig_Click" /><Button Grid.Column="9" Content="设置" Click="Settings_Click" />
            </Grid>
        </Border>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="290" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="320" /></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="White" CornerRadius="10" Padding="10" BorderBrush="#DDE3EA" BorderThickness="1">
                <DockPanel><TextBox DockPanel.Dock="Top" x:Name="ConversationFilterBox" TextChanged="ConversationFilterBox_TextChanged" ToolTip="筛选会话名称或号码" Margin="0,0,0,8" />
                    <ListBox ItemsSource="{Binding VisibleConversations}" BorderThickness="0"><ListBox.ItemTemplate><DataTemplate><CheckBox IsChecked="{Binding IsSelected}" Margin="3,6"><StackPanel><TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" /><TextBlock Text="{Binding Detail}" Foreground="#667085" FontSize="11" /></StackPanel></CheckBox></DataTemplate></ListBox.ItemTemplate></ListBox>
                </DockPanel>
            </Border>
            <Border Grid.Column="2" Background="White" CornerRadius="10" Padding="10" BorderBrush="#DDE3EA" BorderThickness="1">
                <ListView x:Name="MessageList" ItemsSource="{Binding Messages}" MouseDoubleClick="MessageList_MouseDoubleClick" BorderThickness="0"><ListView.View><GridView><GridViewColumn Header="时间" Width="145" DisplayMemberBinding="{Binding LocalTime}" /><GridViewColumn Header="会话" Width="130" DisplayMemberBinding="{Binding ConversationName}" /><GridViewColumn Header="发送者" Width="120" DisplayMemberBinding="{Binding Sender}" /><GridViewColumn Header="内容" Width="360" DisplayMemberBinding="{Binding Text}" /></GridView></ListView.View></ListView>
            </Border>
            <Border Grid.Column="4" Background="White" CornerRadius="10" Padding="12" BorderBrush="#DDE3EA" BorderThickness="1"><DockPanel><TextBlock DockPanel.Dock="Top" Text="消息前后文（双击中间消息查看）" FontWeight="SemiBold" Margin="0,0,0,8" /><TextBox x:Name="ContextBox" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" BorderThickness="0" Background="Transparent" /></DockPanel></Border>
        </Grid>
        <Border Grid.Row="3" Background="#EEF3F8" CornerRadius="8" Padding="10" Margin="0,10,0,0"><TextBlock x:Name="StatusText" Text="就绪。请选择账号和会话；聊天内容只在本机处理。" TextWrapping="Wrap" /></Border>
    </Grid>
</Window>
